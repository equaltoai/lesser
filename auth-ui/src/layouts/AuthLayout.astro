---
import 'src/lib/styles/greater/tokens.css';
import 'src/lib/styles/greater/primitives.css';
import '../styles/global.css';
import LessThanLogo from '../components/LessThanLogo.svelte';

interface Props {
  title: string;
  subtitle?: string;
  variant?: 'default' | 'wide';
}

const { title, subtitle = 'Passwordless authentication', variant = 'default' } = Astro.props;
const rawBaseUrl = import.meta.env.BASE_URL || '/';
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Lesser</title>
  <meta name="description" content="Secure passwordless authentication for Lesser">
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`}>
</head>
<body>
  <div class="auth-container">
    <div class={`auth-card ${variant === 'wide' ? 'auth-card--wide' : ''}`}>
      <div class="auth-header">
        <div class="auth-logo">
          <LessThanLogo client:load />
        </div>
        <h1 class="auth-title">{title}</h1>
        <p class="auth-subtitle">{subtitle}</p>
      </div>
      <slot />
    </div>
  </div>
</body>
</html>
