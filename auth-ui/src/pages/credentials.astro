---
/**
 * ⚠️ STATELESS STATIC APPLICATION - NO SESSIONS OR COOKIES PERMITTED ⚠️
 *
 * This is a static Astro page with NO server-side logic. Credential management
 * happens client-side in CredentialManager.svelte, authenticated with the JWT
 * the login ceremony placed in sessionStorage.
 *
 * No inline <script> or <style> here on purpose: the auth UI ships behind a
 * strict CloudFront CSP whose inline hashes are pinned in Go
 * (infra/cdk/constructs/frontend_response_headers.go), so pages must only emit
 * Astro's own shared island snippets.
 */
import AuthLayout from '../layouts/AuthLayout.astro';
import CredentialManager from '../components/CredentialManager.svelte';
---

<AuthLayout title="Authenticators" subtitle="Manage how you sign in" variant="wide">
  <CredentialManager client:only="svelte" />
</AuthLayout>
