#!/bin/bash
# Pre-commit hook for Lift project
# Runs code compilation, security checks, linting, and tests

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓ $2${NC}"
    else
        echo -e "${RED}✗ $2${NC}"
        exit 1
    fi
}

# 1. Check if code compiles
echo -e "${YELLOW}Checking code compilation...${NC}"
go build ./...
print_status $? "Code compilation"

# 2. Run go fmt check
echo -e "${YELLOW}Checking code formatting...${NC}"
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}✗ Code formatting issues found in:${NC}"
    echo "$UNFORMATTED"
    echo -e "${YELLOW}Run 'go fmt ./...' to fix formatting${NC}"
    exit 1
fi
print_status 0 "Code formatting"

# 3. Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
go vet ./...
print_status $? "Go vet"

# 4. Run security checks with gosec (if available)
if command -v gosec &> /dev/null; then
    echo -e "${YELLOW}Running security scan with gosec...${NC}"
    # Only scan production code - exclude tests, examples, vendor
    # Check if timeout is available (GNU coreutils on macOS) or use fallback
    if command -v timeout &> /dev/null; then
        timeout 30s gosec -tests=false ./pkg/lift ./pkg/middleware ./pkg/security
    elif command -v gtimeout &> /dev/null; then
        gtimeout 30s gosec -tests=false ./pkg/lift ./pkg/middleware ./pkg/security
    else
        # Run without timeout on systems that don't have it
        gosec -tests=false ./pkg/lift ./pkg/middleware ./pkg/security
    fi
    print_status $? "Security scan (gosec)"
else
    echo -e "${YELLOW}⚠ gosec not found, skipping security scan${NC}"
    echo -e "${YELLOW}  Install: curl -sfL https://raw.githubusercontent.com/securego/gosec/master/install.sh | sh -s -- -b \$(go env GOPATH)/bin${NC}"
fi

# 5. Run golangci-lint (if available)
if command -v golangci-lint &> /dev/null; then
    echo -e "${YELLOW}Running golangci-lint...${NC}"
    golangci-lint run ./...
    print_status $? "Linting (golangci-lint)"
else
    echo -e "${YELLOW}⚠ golangci-lint not found, skipping advanced linting${NC}"
fi

# 6. Run tests
echo -e "${YELLOW}Running tests...${NC}"
# Run tests with timeout and without verbose output for cleaner pre-commit
go test -timeout 30s ./pkg/... -short
print_status $? "Tests"

echo -e "${GREEN}All pre-commit checks passed!${NC}"