// MockRepositoryStorage is a mock implementation of core.RepositoryStorage
type MockRepositoryStorage struct {
	mock.Mock
	ActorRepo      *MockActorRepository
	ObjectRepo     *MockObjectRepository
	TrustRepo      *MockTrustRepository
	AccountRepo    *repositories.AccountRepository
	ActivityRepo   *repositories.ActivityRepository
	TimelineRepo   *repositories.TimelineRepository
	NotificationRepo *repositories.NotificationRepository
	LikeRepo       *repositories.LikeRepository
	ModerationRepo *repositories.ModerationRepository
	ListRepo       *repositories.ListRepository
	FollowRepo     *repositories.FollowRepository
	BlockRepo      *repositories.BlockRepository
	MuteRepo       *repositories.MuteRepository
	BookmarkRepo   *repositories.BookmarkRepository
	ScheduledStatusRepo *repositories.ScheduledStatusRepository
	PollRepo       *repositories.PollRepository
	TagRepo        *repositories.TagRepository
	MediaRepo      *repositories.MediaRepository
	SearchRepo     *repositories.SearchRepository
	AIRepo         *repositories.AIRepository
	
	// Core fields
	db         dynamormCore.DB
	tableName  string
	logger     *zap.Logger
}

// NewMockRepositoryStorage creates a new mock repository storage
func NewMockRepositoryStorage() *MockRepositoryStorage {
	return &MockRepositoryStorage{
		ActorRepo:  &MockActorRepository{},
		ObjectRepo: &MockObjectRepository{},
		TrustRepo:  &MockTrustRepository{},
		logger:     zap.NewNop(),
		tableName:  "test-table",
	}
}

// Repository accessor methods
func (m *MockRepositoryStorage) Actor() *repositories.ActorRepository {
	// Return a wrapped version that delegates to our mock
	return repositories.NewActorRepository(m.db, m.tableName, m.logger)
}

func (m *MockRepositoryStorage) Object() *repositories.ObjectRepository {
	return repositories.NewObjectRepository(m.db, m.tableName, m.logger)
}

func (m *MockRepositoryStorage) Trust() *repositories.TrustRepository {
	return repositories.NewTrustRepository(m.db, m.tableName, m.logger)
}

func (m *MockRepositoryStorage) Account() *repositories.AccountRepository {
	return m.AccountRepo
}

func (m *MockRepositoryStorage) Activity() *repositories.ActivityRepository {
	return m.ActivityRepo
}

func (m *MockRepositoryStorage) Timeline() *repositories.TimelineRepository {
	return m.TimelineRepo
}

func (m *MockRepositoryStorage) Notification() *repositories.NotificationRepository {
	return m.NotificationRepo
}

func (m *MockRepositoryStorage) Like() *repositories.LikeRepository {
	return m.LikeRepo
}

func (m *MockRepositoryStorage) Moderation() *repositories.ModerationRepository {
	return m.ModerationRepo
}

func (m *MockRepositoryStorage) List() *repositories.ListRepository {
	return m.ListRepo
}

func (m *MockRepositoryStorage) Follow() *repositories.FollowRepository {
	return m.FollowRepo
}

func (m *MockRepositoryStorage) Block() *repositories.BlockRepository {
	return m.BlockRepo
}

func (m *MockRepositoryStorage) Mute() *repositories.MuteRepository {
	return m.MuteRepo
}

func (m *MockRepositoryStorage) Bookmark() *repositories.BookmarkRepository {
	return m.BookmarkRepo
}

func (m *MockRepositoryStorage) ScheduledStatus() *repositories.ScheduledStatusRepository {
	return m.ScheduledStatusRepo
}

func (m *MockRepositoryStorage) Poll() *repositories.PollRepository {
	return m.PollRepo
}

func (m *MockRepositoryStorage) Tag() *repositories.TagRepository {
	return m.TagRepo
}

func (m *MockRepositoryStorage) Media() *repositories.MediaRepository {
	return m.MediaRepo
}

func (m *MockRepositoryStorage) Search() *repositories.SearchRepository {
	return m.SearchRepo
}

func (m *MockRepositoryStorage) AI() *repositories.AIRepository {
	return m.AIRepo
}

func (m *MockRepositoryStorage) GetDB() dynamormCore.DB {
	return m.db
}

func (m *MockRepositoryStorage) GetTableName() string {
	return m.tableName
}

func (m *MockRepositoryStorage) GetLogger() *zap.Logger {
	return m.logger
}

// MockActorRepository for testing
type MockActorRepository struct {
	mock.Mock
	GetActorFunc func(ctx context.Context, username string) (*activitypub.Actor, error)
}

// MockObjectRepository for testing
type MockObjectRepository struct {
	mock.Mock
	GetObjectFunc func(ctx context.Context, id string) (any, error)
}

// MockTrustRepository for testing
type MockTrustRepository struct {
	mock.Mock
	GetTrustScoreFunc func(ctx context.Context, actorID, category string) (float64, error)
}

