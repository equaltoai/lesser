// TestDataLoaderActorNotFound tests handling of non-existent actors
func TestDataLoaderActorNotFound(t *testing.T) {
	// This is a simple test that doesn't require full mocking
	mockStorage := NewMockRepositoryStorage()
	logger := zap.NewNop()
	
	// Create a custom batch function that always returns an error
	mockStorage.ActorRepo.GetActorFunc = func(ctx context.Context, username string) (*activitypub.Actor, error) {
		return nil, storage.ErrActorNotFound
	}
	
	// Note: This test is still incomplete because we need to properly integrate
	// the mock with the repository pattern. The dataloader expects actual
	// repository instances, not our mocks.
	
	t.Skip("Requires integration with repository pattern")
	
	// When properly implemented, this would test:
	loaders := NewLoaders(mockStorage, logger)
	ctx := WithLoaders(context.Background(), loaders)
	
	actor, err := LoadActor(ctx, "nonexistent")
	assert.Error(t, err)
	assert.Nil(t, actor)
	assert.Equal(t, storage.ErrActorNotFound, err)
}

