{
  "kind": "lesser.deploy_assembly_descriptor",
  "schema_version": 1,
  "release": {
    "name": "lesser",
    "version": "v1.2.3",
    "git_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "assembly": {
    "path": "lesser-deploy-assembly.tar.gz",
    "format": "tar.gz",
    "sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  },
  "payload": {
