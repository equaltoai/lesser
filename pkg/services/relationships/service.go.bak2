	if err := common.ValidateRequiredParam("user_id", strings.TrimSpace(query.UserID)); err != nil {
		return err
	}
	if err := common.ValidateRequiredParam("severed_relationship_id", strings.TrimSpace(query.SeveredRelationshipID)); err != nil {
		return err
