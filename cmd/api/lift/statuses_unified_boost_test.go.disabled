func TestHandleUnifiedBoostLift_TraditionalBoost(t *testing.T) {
	// Setup
	cfg := &config.Config{
		Domain: "test.example.com",
	}
	logger := zap.NewNop()
	handler := NewHandler(cfg, &MockRepositoryStorage{}, logger, nil)

	// Mock actor
	actor := &activitypub.Actor{
		BaseObject: activitypub.BaseObject{
			ID: "https://test.example.com/users/testuser",
		},
		PreferredUsername: "testuser",
		Name:              "Test User",
		Followers:         "https://test.example.com/users/testuser/followers",
	}

	// Setup mocks
	mockStore.On("GetActor", mock.Anything, "testuser").Return(actor, nil)
	mockStore.On("CreateAnnounce", mock.Anything, mock.AnythingOfType("*storage.Announce")).Return(nil)
	mockStore.On("CreateActivity", mock.Anything, mock.AnythingOfType("*activitypub.Activity")).Return(nil)
	mockStore.On("RecordStatusEngagement", mock.Anything, mock.Anything, "boost", actor.ID).Return(nil)
	mockStore.On("CountObjectAnnounces", mock.Anything, mock.Anything).Return(int64(1), nil)

	// Create test context
	ctx := createTestContext("POST", "/api/v1/statuses/123/reblog", "", map[string]string{
		"X-Test-Username": "testuser",
	})
	ctx.SetParam("id", "123")

	// Execute
	err := handler.HandleUnifiedBoostLift(ctx)

	// Assert
	assert.NoError(t, err)
	assert.Equal(t, http.StatusOK, ctx.Response.StatusCode)

	// Verify response
	var resp models.FavouriteResponse
	bodyBytes, err := json.Marshal(ctx.Response.Body)
	assert.NoError(t, err)
	err = json.Unmarshal(bodyBytes, &resp)
	assert.NoError(t, err)
	assert.Equal(t, "123", resp.ID)
	assert.True(t, resp.Reblogged)
	assert.Equal(t, int64(1), resp.ReblogsCount)
	assert.Equal(t, "https://test.example.com/objects/123", resp.URI)

}

func TestHandleUnifiedBoostLift_QuoteBoost(t *testing.T) {
	// Setup
	cfg := &config.Config{
		Domain: "test.example.com",
	}
	logger := zap.NewNop()
	handler := NewHandler(cfg, &MockRepositoryStorage{}, logger, nil)

	// Mock actor
	actor := &activitypub.Actor{
		BaseObject: activitypub.BaseObject{
			ID: "https://test.example.com/users/testuser",
		},
		PreferredUsername: "testuser",
		Name:              "Test User",
		Followers:         "https://test.example.com/users/testuser/followers",
		Icon: &activitypub.Image{
			URL: "https://test.example.com/avatar.jpg",
		},
	}

	// Setup mocks
	mockStore.On("GetActor", mock.Anything, "testuser").Return(actor, nil)
	mockStore.On("CreateObject", mock.Anything, mock.AnythingOfType("*activitypub.QuoteNote")).Return(nil)
	mockStore.On("CreateQuoteRelationship", mock.Anything, mock.AnythingOfType("*storage.QuoteRelationship")).Return(nil)
	mockStore.On("IncrementReblogCount", mock.Anything, mock.Anything).Return(nil)
	mockStore.On("CreateActivity", mock.Anything, mock.AnythingOfType("*activitypub.Activity")).Return(nil)
	mockStore.On("FanOutPost", mock.Anything, mock.AnythingOfType("*activitypub.Activity")).Return(nil)
	mockStore.On("RecordStatusEngagement", mock.Anything, mock.Anything, "quote", actor.ID).Return(nil)
	mockStore.On("GetObject", mock.Anything, mock.Anything).Return(nil, fmt.Errorf("not found"))

	// Request body with comment (quote boost)
	reqBody := `{"comment": "This is a great post!", "visibility": "public"}`

	// Create test context
	ctx := createTestContext("POST", "/api/v1/statuses/123/reblog", reqBody, map[string]string{
		"X-Test-Username": "testuser",
		"Content-Type":    "application/json",
	})
	ctx.SetParam("id", "123")

	// Execute
	err := handler.HandleUnifiedBoostLift(ctx)

	// Assert
	assert.NoError(t, err)
	assert.Equal(t, http.StatusOK, ctx.Response.StatusCode)

	// Verify response
	var resp models.Status
	bodyBytes, err := json.Marshal(ctx.Response.Body)
	assert.NoError(t, err)
	err = json.Unmarshal(bodyBytes, &resp)
	assert.NoError(t, err)
	assert.Equal(t, "This is a great post!", resp.Content)
	assert.True(t, resp.IsQuoteBoost)
	assert.NotNil(t, resp.QuotedStatusID)
	assert.Equal(t, "public", resp.Visibility)
	assert.Equal(t, "testuser", resp.Account.Username)
	assert.Equal(t, "https://test.example.com/avatar.jpg", resp.Account.Avatar)

}

