func TestHandleUndoUnifiedBoostLift_UndoTraditionalBoost(t *testing.T) {
	// Setup
	cfg := &config.Config{
		Domain: "test.example.com",
	}
	logger := zap.NewNop()
	handler := NewHandler(cfg, &MockRepositoryStorage{}, logger, nil)

	// Mock actor
	actor := &activitypub.Actor{
		BaseObject: activitypub.BaseObject{
			ID: "https://test.example.com/users/testuser",
		},
		PreferredUsername: "testuser",
		Name:              "Test User",
	}

	// Mock announce
	announce := &storage.Announce{
		ID:     "announce-123",
		Actor:  actor.ID,
		Object: "https://test.example.com/objects/123",
	}

	// Setup mocks
	mockStore.On("GetActor", mock.Anything, "testuser").Return(actor, nil)
	mockStore.On("GetAnnounce", mock.Anything, actor.ID, "https://test.example.com/objects/123").Return(announce, nil)
	mockStore.On("DeleteAnnounce", mock.Anything, actor.ID, "https://test.example.com/objects/123").Return(nil)
	mockStore.On("CreateActivity", mock.Anything, mock.AnythingOfType("*activitypub.Activity")).Return(nil)
	mockStore.On("GetQuoteRelationshipsByQuoter", mock.Anything, actor.ID).Return([]*storage.QuoteRelationship{}, nil)
	mockStore.On("CountObjectAnnounces", mock.Anything, mock.Anything).Return(int64(0), nil)

	// Create test context
	ctx := createTestContext("POST", "/api/v1/statuses/123/unreblog", "", map[string]string{
		"X-Test-Username": "testuser",
	})
	ctx.SetParam("id", "123")

	// Execute
	err := handler.HandleUndoUnifiedBoostLift(ctx)

	// Assert
	assert.NoError(t, err)
	assert.Equal(t, http.StatusOK, ctx.Response.StatusCode)

	// Verify response
	var resp models.FavouriteResponse
	bodyBytes, err := json.Marshal(ctx.Response.Body)
	assert.NoError(t, err)
	err = json.Unmarshal(bodyBytes, &resp)
	assert.NoError(t, err)
	assert.Equal(t, "123", resp.ID)
	assert.False(t, resp.Reblogged)
	assert.Equal(t, int64(0), resp.ReblogsCount)

}

func TestHandleUndoUnifiedBoostLift_UndoQuoteBoost(t *testing.T) {
	// Setup
	cfg := &config.Config{
		Domain: "test.example.com",
	}
	logger := zap.NewNop()
	handler := NewHandler(cfg, &MockRepositoryStorage{}, logger, nil)

	// Mock actor
	actor := &activitypub.Actor{
		BaseObject: activitypub.BaseObject{
			ID: "https://test.example.com/users/testuser",
		},
		PreferredUsername: "testuser",
		Name:              "Test User",
	}

	// Mock quote relationship
	quoteRelationship := &storage.QuoteRelationship{
		ID:           "quote-123",
		QuoterNoteID: "note-456", 
		TargetNoteID: "https://test.example.com/objects/123",
		QuoterID:     actor.ID,
		Timestamp:    time.Now(),
	}

	// Setup mocks
	mockStore.On("GetActor", mock.Anything, "testuser").Return(actor, nil)
	mockStore.On("GetAnnounce", mock.Anything, actor.ID, "https://test.example.com/objects/123").Return(nil, fmt.Errorf("not found"))
	mockStore.On("GetQuoteRelationshipsByQuoter", mock.Anything, actor.ID).Return([]*storage.QuoteRelationship{quoteRelationship}, nil)
	mockStore.On("DeleteQuoteRelationship", mock.Anything, "quote-123").Return(nil)
	mockStore.On("DecrementReblogCount", mock.Anything, "https://test.example.com/objects/123").Return(nil)
	mockStore.On("CreateActivity", mock.Anything, mock.AnythingOfType("*activitypub.Activity")).Return(nil)
	mockStore.On("DeleteObject", mock.Anything, "https://test.example.com/objects/note-456").Return(nil)
	mockStore.On("CountObjectAnnounces", mock.Anything, mock.Anything).Return(int64(0), nil)

	// Create test context
	ctx := createTestContext("POST", "/api/v1/statuses/123/unreblog", "", map[string]string{
		"X-Test-Username": "testuser",
	})
	ctx.SetParam("id", "123")

	// Execute
	err := handler.HandleUndoUnifiedBoostLift(ctx)

	// Assert
	assert.NoError(t, err)
	assert.Equal(t, http.StatusOK, ctx.Response.StatusCode)

	// Verify response
	var resp models.FavouriteResponse
	bodyBytes, err := json.Marshal(ctx.Response.Body)
	assert.NoError(t, err)
	err = json.Unmarshal(bodyBytes, &resp)
	assert.NoError(t, err)
	assert.Equal(t, "123", resp.ID)
	assert.False(t, resp.Reblogged)

}

func TestHandleUndoUnifiedBoostLift_NothingToUndo(t *testing.T) {
	// Setup
	cfg := &config.Config{
		Domain: "test.example.com",
	}
	logger := zap.NewNop()
	handler := NewHandler(cfg, &MockRepositoryStorage{}, logger, nil)

	// Mock actor
	actor := &activitypub.Actor{
		BaseObject: activitypub.BaseObject{
			ID: "https://test.example.com/users/testuser",
		},
		PreferredUsername: "testuser",
		Name:              "Test User",
	}

	// Setup mocks - nothing found to undo
	mockStore.On("GetActor", mock.Anything, "testuser").Return(actor, nil)
	mockStore.On("GetAnnounce", mock.Anything, actor.ID, "https://test.example.com/objects/123").Return(nil, fmt.Errorf("not found"))
	mockStore.On("GetQuoteRelationshipsByQuoter", mock.Anything, actor.ID).Return([]*storage.QuoteRelationship{}, nil)
	mockStore.On("CountObjectAnnounces", mock.Anything, mock.Anything).Return(int64(0), nil)

	// Create test context
	ctx := createTestContext("POST", "/api/v1/statuses/123/unreblog", "", map[string]string{
		"X-Test-Username": "testuser",
	})
	ctx.SetParam("id", "123")

	// Execute
	err := handler.HandleUndoUnifiedBoostLift(ctx)

	// Assert - should succeed for idempotency
	assert.NoError(t, err)
	assert.Equal(t, http.StatusOK, ctx.Response.StatusCode)

	// Verify response
	var resp models.FavouriteResponse
	bodyBytes, err := json.Marshal(ctx.Response.Body)
	assert.NoError(t, err)
	err = json.Unmarshal(bodyBytes, &resp)
	assert.NoError(t, err)
	assert.Equal(t, "123", resp.ID)
	assert.False(t, resp.Reblogged)

}

